---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import Announcement from '~/components/widgets/Announcement.astro';

import { headerData, footerData } from '~/navigation';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
}

const { metadata } = Astro.props;
---

<Layout metadata={metadata}>
  <slot name="head" slot="head" />
  {
    /*
    Slot fallbacks are rendered explicitly. With `<slot name="x">fallback</slot>`
    Astro still evaluates the fallback when the page overrides the slot, and
    astro-icon then believes the icons inside it (the RSS icon of the default
    header, for instance) were already emitted, so their SVG sprite symbol
    goes missing on that page.
  */
  }
  {Astro.slots.has('announcement') ? <slot name="announcement" /> : <Announcement />}
  {Astro.slots.has('header') ? <slot name="header" /> : <Header {...headerData} isSticky showRssFeed showToggleTheme />}
  <main class="flex-1" class="bg-[url('public/background.JPG')] bg-cover bg-center bg-no-repeat py-20">
    <slot />
    <!-- 🟢 把全局 Toast 弱弹窗放在这里，确保全站任何页面都能显示 -->
  <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 pointer-events-none opacity-0 translate-y-4 transition-all duration-300 ease-out">
    <div class="bg-slate-900/90 dark:bg-white/90 text-white dark:text-slate-900 text-sm font-medium px-4 py-2.5 rounded-full shadow-lg backdrop-blur-sm flex items-center gap-2">
      <svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
      <span id="toast-text">已复制到剪贴板！</span>
    </div>
  </div>
  </main>
  {Astro.slots.has('footer') ? <slot name="footer" /> : <Footer {...footerData} />}
</Layout>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toast = document.getElementById('toast');
    const toastText = document.getElementById('toast-text');
    let toastTimer = null;

    function showToast(message) {
      if (!toast) return;
      if (toastTimer) clearTimeout(toastTimer);

      toastText.textContent = message;
      toast.classList.remove('opacity-0', 'translate-y-4');
      toast.classList.add('opacity-100', 'translate-y-0');

      toastTimer = setTimeout(() => {
        toast.classList.remove('opacity-100', 'translate-y-0');
        toast.classList.add('opacity-0', 'translate-y-4');
      }, 2000);
    }

    // 全局事件委托：监听所有带有 data-aw-social-share="qq" 的点击
    Array.from(document.getElementsByClassName('share-button')).forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const qqBtn = document.getElementsByClassName('share-button')[0];
        if (!qqBtn) return;

      const shareUrl = qqBtn.getAttribute('data-aw-url') || window.location.href;
      const shareText = qqBtn.getAttribute('data-aw-text') || document.title;
      const copyContent = `${shareText}\n链接：${shareUrl}`;

      try {
        await navigator.clipboard.writeText(copyContent);
        showToast('已复制到剪贴板，快去粘贴分享吧！');
      } catch (err) {
        console.error('复制失败:', err);
        showToast('复制失败，请手动复制链接');
      }
    });
  });
});
</script>