---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: '联系',
  description:
    '有任何宝贵的意见欢迎联系我向我发聩！',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="联系" title="每一份意见都弥足珍贵" />

  <ContactUs
    id="form"
    title="给我发消息！"
    subtitle="直接社交软件私信其实效率更高"
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
      },
    ]}
    textarea={{
      label: 'Message',
    }}
    disclaimer={{
      label:
        '通过提交此表单，您同意我根据隐私政策处理您的数据。',
    }}
    description="我看心情回复您！"
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="We are here to help!"
    items={[
      
      {
        title: 'Phone',
        description: '电话？不告诉你',
        icon: 'tabler:headset',
      },
      {
        title: 'Email',
        description: 'mobellling@gmail.com',
        icon: 'tabler:mail',
      },
      {
        title: 'Location',
        description: '位置？不告诉你',
        icon: 'tabler:map-pin',
      },
    ]}
  />
</Layout>
