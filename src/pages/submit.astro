---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '用户投稿',
};
---

<Layout metadata={metadata}>
  <section class="px-6 py-12 max-w-xl mx-auto min-h-[60vh]">
    <h1 class="text-3xl font-bold mb-2 text-center text-heading">请输入您的信息</h1>
    <p class="text-center text-gray-500 mb-8">按照格式发送邮件，期待您的投稿！</p>


    
<form action="https://api.staticforms.dev/submit" method="POST"  
class="space-y-6 bg-white dark:bg-slate-900 p-8 rounded-xl shadow-md border border-slate-100 dark:border-slate-800"
>
  <input type="hidden" name="apiKey" value="sf_3b8017ebc677397163a9afd2">
<div>

  <!-- your own inputs -->
<label class="block text-sm font-medium mb-2 text-heading">Name</label>
        <input 
          type="text" 
          name="name" 
          required 
          class="w-full px-4 py-2 border rounded-lg dark:bg-slate-800 dark:border-slate-700" 
          placeholder="您的名字或昵称" 
        />
      </div>

      <!-- 3. 邮箱输入框（方便你收到邮件后直接点击回复） -->
      <div>
        <label class="block text-sm font-medium mb-2 text-heading">Title</label>
        <input 
          type="text" 
          name="title" 
          required 
          class="w-full px-4 py-2 border rounded-lg dark:bg-slate-800 dark:border-slate-700" 
          placeholder="标题" 
        />
      </div>

      <!-- 4. 投稿内容文本域 -->
      <div>
        <label class="block text-sm font-medium mb-2 text-heading">Message</label>
        <textarea 
          name="message" 
          rows="5" 
          required 
          class="w-full px-4 py-2 border rounded-lg dark:bg-slate-800 dark:border-slate-700" 
          placeholder="写下你的投稿内容或想说的话...不应少于500字！"
        ></textarea>
      </div>

      <!-- 5. 蓝色的提交按钮 -->
      <button 
        type="submit" 
        class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 rounded-xl transition duration-200 shadow-lg shadow-blue-500/25"
      >
        提交
      </button>
      <p class="text-center text-xs text-gray-400">审核后发布！请勿重复提交！！</p>
      <p class="text-center text-xs text-gray-400">看到successful即为提交成功！请勿重复提交！！</p>

</form>
<script src="https://www.staticforms.dev/scripts/staticforms.js" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    StaticForms.attach(document.querySelector('form'));
  });
</script>
    
  </section>
</Layout>
