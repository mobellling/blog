---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '用户投稿',
};
---

<Layout metadata={metadata}>
  <section class="px-6 py-12 max-w-xl mx-auto min-h-[60vh]">
    <h1 class="text-3xl font-bold mb-2 text-center text-heading">请输入您的信息</h1>
    <p class="text-center text-gray-500 mb-8">按照格式发送邮件，期待您的投稿！</p>


    
<form id="contribForm"
action="https://api.staticforms.dev/submit" method="POST"  
class="space-y-6 bg-white dark:bg-slate-900 p-8 rounded-xl shadow-md border border-slate-100 dark:border-slate-800"

>
  <input type="hidden" name="apiKey" value="sf_3b8017ebc677397163a9afd2">
<div>


  <!-- your own inputs -->
<label class="block text-sm font-medium mb-2 text-heading">Name</label>
        <input 
          type="text" 
          name="name" 
          required 
          class="w-full px-4 py-2 border rounded-lg dark:bg-slate-800 dark:border-slate-700" 
          placeholder="您的名字或昵称" 
        />
      </div>

      <!-- 3. 邮箱输入框（方便你收到邮件后直接点击回复） -->
      <div>
        <label class="block text-sm font-medium mb-2 text-heading">Title</label>
        <input 
          type="text" 
          name="title" 
          required 
          class="w-full px-4 py-2 border rounded-lg dark:bg-slate-800 dark:border-slate-700" 
          placeholder="标题" 
        />
      </div>


       <!-- 5. 标签输入 -->
      <div>
        <label class="block text-sm font-medium mb-2 text-heading">Tag</label>
        <input 
          type="text" 
          name="tag" 
          required 
          class="w-full px-4 py-2 border rounded-lg dark:bg-slate-800 dark:border-slate-700" 
          placeholder="标签（示例：- 技术 - 博客）" 
        />
      </div>

      <!-- 4. 投稿内容文本域 -->
      <div>
        <label class="block text-sm font-medium mb-2 text-heading">Message</label>
        <textarea 
          name="message" 
          rows="5" 
          required 
          class="w-full px-4 py-2 border rounded-lg dark:bg-slate-800 dark:border-slate-700" 
          placeholder="写下你的投稿内容或想说的话...不应少于500字！"
        ></textarea>
      </div>
        <!-- 图片链接输入栏 -->
<div class="mb-4">
  <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
    头图链接 (可选)
  </label>
  <div class="flex gap-2">
    <input 
      type="url" 
      name="imageUrl" 
      placeholder="如果想上传图片，请在此粘贴图片直链（URL）"
      class="w-full px-4 py-2 border rounded-md dark:bg-slate-800 dark:border-slate-700 dark:text-white text-sm"
    />
  </div>


  <!-- 引导用户的说明文字 -->
  <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
    提示：您可以先将图片上传至免费图床（如 
    <a href="https://mini-tools.uk/upload?lang=zh-CN" target="_blank" class="text-blue-600 dark:text-blue-400 underline">mini-tools</a>)
    
    然后复制其“图片直链”粘贴到这里。
  </p>
</div>


      <!-- 5. 蓝色的提交按钮 -->
      <button 
        type="submit" 
        class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 rounded-xl transition duration-200 shadow-lg shadow-blue-500/25"
      >
        提交
      </button>
      <!-- 成功后的提示弹窗（可以默认隐藏） -->
<div id="successMsg" class="hidden fixed bottom-5 right-5 bg-green-500 text-white px-6 py-3 rounded-lg shadow-lg transition-all">
   投稿成功！感谢您的分享，我会尽快审核。
</div>
      <p class="text-center text-xs text-gray-400">审核后发布！请勿重复提交！！</p>
      <p class="text-center text-xs text-gray-400">看到successful即为提交成功！请勿重复提交！！</p>

</form>
<script src="https://www.staticforms.dev/scripts/staticforms.js" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    StaticForms.attach(document.querySelector('form'));
  });
</script>
    
  </section>
</Layout>
