---
import Layout from '~/layouts/PageLayout.astro';
import { getPermalink, getBlogPermalink, getAsset } from '../utils/permalinks';
import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import QuickStart from '~/components/widgets/QuickStart.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Timeline from '~/components/widgets/Timeline.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogHighlightedPosts from '~/components/widgets/BlogHighlightedPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import SocialProof from '~/components/widgets/SocialProof.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

const metadata = {
  title: 'MobellSite',
  ignoreTitleTemplate: true,
};

// Structured data for the site and its publisher, built only from
// `src/config.yaml` (`site.name`, `site.site`, `metadata.twitter.handle`), so
// it is correct for any site made with the template. Blog posts add
// BlogPosting on their own; the FAQs widget adds FAQPage.
const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];

---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />
  
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="欢迎！"
    actions={[
      {
        
        text: '关于',
        href: getPermalink('/aboutme'), 
      },
      {
        variant: 'primary',
        text: '博客',
        href: getBlogPermalink(), 
      },
      { 
       variant: 'tertiary',
       text: 'bilibili主页',
       href: 'https://space.bilibili.com/1917373256',
       target: '_blank',
       },
    ]}
    
  >
    
    <Fragment slot="title">
      This is a website modified by Mobell.
    </Fragment>

    <Fragment slot="subtitle">
      
      <span class="block mb-1 sm:hidden font-bold text-blue-600">功能仍在改进中~.</span>
      你可以在这里找到blog，之后或许我会添加一点新内容？
    </Fragment>
  </Hero>
  
</Layout>
